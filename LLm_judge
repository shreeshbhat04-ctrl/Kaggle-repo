orizer.transform(df['response_a'].fillna(''))\n","    vec_b = tfidf_vectorizer.transform(df['response_b'].fillna(''))\n","    \n","    features['tfidf_sim'] = np.asarray(vec_a.multiply(vec_b).sum(axis=1)).ravel()\n","    \n","    # EXACTLY 2 VALUES RETURNED\n","    return features, tfidf_vectorizer"]},{"cell_type":"code","execution_count":3,"id":"c405a948","metadata":{"execution":{"iopub.execute_input":"2026-09-14T18:25:39.516357Z","iopub.status.busy":"2026-09-14T18:25:39.51598Z","iopub.status.idle":"2026-09-14T18:25:39.523925Z","shell.execute_reply":"2026-09-14T18:25:39.522981Z"},"papermill":{"duration":0.014282,"end_time":"2026-09-14T18:25:39.526035+00:00","exception":false,"start_time":"2026-09-14T18:25:39.511753+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def train_baseline(train_df: pd.DataFrame):\n","    # Target encoding: 0 -> Model A, 1 -> Model B, 2 -> Tie\n","    target_map = {'winner_model_a': 0, 'winner_model_b': 1, 'winner_tie': 2}\n","    y = train_df['target'].map(target_map).values\n","    X = extract_features(train_df)\n","    \n","    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n","    oof_preds = np.zeros((len(train_df), 3))\n","    \n","    for fold, (train_idx, val_idx) in enumerate(skf.split(X, y)):\n","        X_train, y_train = X.iloc[train_idx], y[train_idx]\n","        X_val, y_val = X.iloc[val_idx], y[val_idx]\n","        \n","        model = CatBoostClassifier(\n","            iterations=500,\n","            learning_rate=0.05,\n","            loss_function='MultiClass',\n","            eval_metric='MultiClass',\n","            random_seed=42,\n","            verbose=100\n","        )\n","        \n","        model.fit(X_train, y_train, eval_set=(X_val, y_val), early_stopping_rounds=50)\n","        oof_preds[val_idx] = model.predict_proba(X_val)\n","        \n","    score = log_loss(y, oof_preds)\n","    print(f\"\\n---> Cross-Validation Log Loss: {score:.4f}\")\n","    return model\n"]},{"cell_typ